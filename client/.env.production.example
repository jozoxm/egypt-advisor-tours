# ============================================================
# PRODUCTION ENVIRONMENT VARIABLES
# ============================================================
# Copy this file to .env.production and fill in your values.
# For Vercel deployment, set these in:
#   Vercel Dashboard → Project → Settings → Environment Variables
#
# IMPORTANT: Never commit .env.production to git – it contains secrets.
# ============================================================

# ----------------------------------------------------------
# EmailJS – required for booking & trip-tailor forms to work
# ----------------------------------------------------------
# 1. Sign up at https://www.emailjs.com (free for ≤ 200 emails/month)
# 2. Connect your Gmail or SMTP service under "Email Services"
# 3. Create two email templates (one for bookings, one for trip tailor enquiries)
# 4. Copy the IDs below from your EmailJS dashboard

# Your EmailJS Service ID (e.g. "service_abc123")
REACT_APP_EMAILJS_SERVICE_ID=your_emailjs_service_id

# Email template ID for booking confirmations (e.g. "template_booking123")
# Suggested template variables: {{tour_name}}, {{customer_name}}, {{customer_email}},
# {{customer_phone}}, {{number_of_people}}, {{booking_date}}, {{booking_time}},
# {{special_requests}}, {{total_price}}
REACT_APP_EMAILJS_BOOKING_TEMPLATE_ID=your_emailjs_booking_template_id

# Email template ID for "Tailor My Trip" enquiries (e.g. "template_tailor123")
# Suggested template variables: {{full_name}}, {{email}}, {{phone}}, {{whatsapp}},
# {{travel_dates}}, {{travelers}}, {{travel_style}}, {{accommodation}},
# {{interests}}, {{pace}}, {{budget}}, {{must_see}}, {{language}}, {{notes}}
REACT_APP_EMAILJS_TRIPTAILOR_TEMPLATE_ID=your_emailjs_triptailor_template_id

# Your EmailJS Public Key (found in Account → API Keys)
REACT_APP_EMAILJS_PUBLIC_KEY=your_emailjs_public_key

# ----------------------------------------------------------
# App settings (optional)
# ----------------------------------------------------------
REACT_APP_VERSION=1.0.2
