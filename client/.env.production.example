# ============================================================
# PRODUCTION ENVIRONMENT VARIABLES
# ============================================================
# Copy this file to .env.production and fill in your values.
# For Vercel deployment, set these in:
#   Vercel Dashboard → Project → Settings → Environment Variables
#
# IMPORTANT: Never commit .env.production to git – it contains secrets.
# ============================================================

# Backend API base URL.
REACT_APP_API_URL=

# Admin panel secret — must EXACTLY match the server's ADMIN_SECRET env var.
REACT_APP_ADMIN_SECRET=

# App settings (optional)
REACT_APP_VERSION=1.0.3
