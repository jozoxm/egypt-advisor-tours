# Disable automatic browser opening
BROWSER=none

# Disable source maps in development (faster rebuilds)
GENERATE_SOURCEMAP=false

# Enable fast refresh
FAST_REFRESH=true

# API URL for admin panel (local backend)
REACT_APP_API_URL=http://localhost:5000

# Admin panel secret — must EXACTLY match the server's ADMIN_SECRET env var.
# If your server has ADMIN_SECRET set, copy the same value here.
# To avoid committing real secrets, override this in a gitignored
# .env.development.local file instead of changing this file.
REACT_APP_ADMIN_SECRET=

# App version (update when making changes)
REACT_APP_VERSION=1.0.2

# ---------------------------------------------------------------
# EmailJS vars are intentionally left out for local development.
# Email forms will log a warning and skip sending — that's expected.
# To test emails locally, copy values from your EmailJS dashboard into
# a gitignored .env.development.local file (never commit real keys).
# ---------------------------------------------------------------
# REACT_APP_EMAILJS_SERVICE_ID=
# REACT_APP_EMAILJS_BOOKING_TEMPLATE_ID=
# REACT_APP_EMAILJS_TRIPTAILOR_TEMPLATE_ID=
# REACT_APP_EMAILJS_PUBLIC_KEY=
