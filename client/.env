CI=false

# ============================================================
# REACT_APP_* variables — required for production builds
# ============================================================
# These get embedded into the compiled JS bundle at build time.
# Fill in your real values before running `npm run build`.
# For Vercel: set these in Dashboard → Project → Settings → Environment Variables.
# For Hostinger: set these in hPanel → Node.js → Environment Variables, then rebuild.
# For local builds: fill in below (do NOT commit real secrets).
# ============================================================

# Backend API base URL.
# Leave empty to use relative paths (correct for Vercel and same-origin Hostinger deploys).
# Set to http://localhost:5000 for local dev (override in .env.development).
REACT_APP_API_URL=

# Admin panel secret — must EXACTLY match the server's ADMIN_SECRET env var.
# Generate a strong random string: https://generate-secret.now.sh/32
REACT_APP_ADMIN_SECRET=
