coverage/

# Runtime data — written by the server when the admin saves content.
# These files must NOT be tracked so that Hostinger (and other Git-connected
# hosts) never overwrite live admin data when pulling a new deployment.
# The server seeds them from client/src/data/*.js on first startup.
server/data/*.json

# Payload CMS — generated files and database
cms/payload-types.ts
data/payload.db
data/payload.db-shm
data/payload.db-wal

# Payload CMS — uploaded media files (written at runtime, not tracked in git)
/media/

# Temporary files
*.tmp
*.temp
/tmp/
.vercel
.env*.local
client/package-lock.json
".env" 
".env.local" 
".env.*.local" 
