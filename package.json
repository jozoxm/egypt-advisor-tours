{
  "name": "egypt-advisor-tours",
  "version": "1.0.0",
  "description": "Egypt Advisor Tours - Travel planning platform",
  "private": true,
  "main": "index.js",
  "scripts": {
    "install:all": "npm install && npm install --prefix client && npm install --prefix server",
    "install:client": "npm install --prefix client",
    "install:server": "npm install --prefix server",
    "setup": "npm run install:all",
    "postinstall": "npm install --prefix server --production=false && node scripts/build-client.js",
    "start": "node start.js",
    "server": "npm start --prefix server",
    "start:client": "npm start --prefix client",
    "start:server": "npm start --prefix server",
    "build": "node scripts/build-client.js",
    "test": "npm test --prefix client",
    "test:server": "npm test --prefix server",
    "test:client": "npm test --prefix client",
    "test:all": "npm test --prefix client -- --watchAll=false --passWithNoTests && npm test --prefix server -- --watchAll=false",
    "dev:client": "npm start --prefix client",
    "dev:server": "npm run dev --prefix server",
    "dev": "npm run dev:server"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.21.0",
    "express-rate-limit": "^8.3.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.2",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "jest": "^30.3.0",
    "nodemon": "^3.0.1",
    "supertest": "^7.2.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "author": "jozoxm",
  "license": "ISC",
  "homepage": "https://egyptadvisortours.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jozoxm/egypt-advisor-tours.git"
  },
  "directories": {
    "doc": "docs"
  },
  "keywords": [],
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/jozoxm/egypt-advisor-tours/issues"
  }
}