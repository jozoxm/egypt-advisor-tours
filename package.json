{
  "name": "egypt-advisor-tours-monorepo",
  "version": "1.0.0",
  "description": "Egypt Advisor Tours - Travel Agency Website",
  "private": true,
  "scripts": {
    "install:all": "npm install && npm run install:client && npm run install:server",
    "install:client": "cd client && npm install",
    "install:server": "cd server && npm install",
    "start:client": "cd client && npm start",
    "start:server": "cd server && npm start",
    "build:client": "cd client && npm run build",
    "test:client": "cd client && npm test",
    "clean": "rm -rf client/node_modules server/node_modules node_modules"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jozoxm/egypt-advisor-tours.git"
  },
  "keywords": [
    "travel",
    "tours",
    "egypt",
    "react",
    "nodejs",
    "express",
    "mongodb"
  ],
  "author": "jozoxm",
  "license": "ISC",
  "engines": {
    "node": ">=14.0.0",
    "npm": ">=6.0.0"
  }
}
