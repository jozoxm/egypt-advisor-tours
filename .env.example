# ============================================================
# Egypt Advisor Tours — Environment Variables
# ============================================================
# Copy this file to .env (server) and client/.env (React) and fill in your values.
# NEVER commit .env files with real secrets to version control.

# ============================================================
# SERVER — copy these to .env in the project root (or set in Railway/Hostinger)
# ============================================================

# Port the Express server listens on (defaults to 5000)
PORT=5000

# Admin secret: set a strong random string here to protect all admin API endpoints.
# The React app must pass this in the X-Admin-Secret header (see REACT_APP_ADMIN_SECRET).
# Leave blank to disable auth (development only).
ADMIN_SECRET=replace-with-a-long-random-secret

# ============================================================
# CLIENT — copy these to client/.env (or set in Vercel project settings)
# Prefix all React env vars with REACT_APP_
# ============================================================

# Backend API base URL (leave empty to use relative paths — works on Vercel)
REACT_APP_API_URL=

# Must match the server's ADMIN_SECRET above
REACT_APP_ADMIN_SECRET=replace-with-a-long-random-secret

# EmailJS credentials (https://www.emailjs.com — free up to 200 emails/month)
REACT_APP_EMAILJS_SERVICE_ID=your_emailjs_service_id
REACT_APP_EMAILJS_BOOKING_TEMPLATE_ID=your_booking_template_id
REACT_APP_EMAILJS_TRIPTAILOR_TEMPLATE_ID=your_triptailor_template_id
REACT_APP_EMAILJS_PUBLIC_KEY=your_emailjs_public_key
