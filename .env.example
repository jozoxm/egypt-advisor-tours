# ============================================================
# Egypt Advisor Tours — Environment Variables Reference
# ============================================================
# ⚠️  NEVER commit a file containing real secrets to version control.
#
# WHERE TO PUT THESE VALUES:
#
#   ┌─ Hostinger (Node.js hosting / VPS) ───────────────────────────┐
#   │  Option A (recommended): hPanel → Node.js → Environment Vars  │
#   │  Option B: Create a .env file in the project root via SSH      │
#   │            and copy+fill in the SERVER section below.          │
#   │  REACT_APP_* vars must be set BEFORE running `npm run build`.  │
#   │  Fill them in client/.env, build, then deploy the build folder.│
#   └────────────────────────────────────────────────────────────────┘
#
# ============================================================
# SERVER — runtime variables (project root .env or hosting panel)
# ============================================================

# Port the Express server listens on (defaults to 5000 if not set)
PORT=5000

# Admin credentials — protects all /api/* write endpoints.
# ADMIN_SECRET  : a long random string used as the JWT signing key.
#                 Generate one: https://generate-secret.now.sh/32
# ADMIN_PASSWORD: the password entered on the /admin/login screen.
#                 Defaults to ADMIN_SECRET if not set (backward compat).
# ADMIN_USERNAME: login username shown on the login page (default: "admin").
ADMIN_SECRET=replace-with-a-long-random-secret
ADMIN_PASSWORD=replace-with-a-secure-password
ADMIN_USERNAME=admin

# Persistent data directory — IMPORTANT for Hostinger (and any host that wipes
# the project directory on each deployment).
# Set this to an absolute path OUTSIDE the project folder so admin-saved data
# (tours, blogs, gallery, etc.) survives across git pull / re-deployments.
#
# Example for Hostinger:
#   DATA_PATH=/home/u123456789/admin_data
#
# Leave blank to use the default: <project>/server/data/  (fine for local dev
# and for hosts that do in-place git pulls without deleting untracked files).
DATA_PATH=

# CORS allowed origin — restricts which domain the browser may call the API from.
# Set to your frontend URL when running the API on a separate domain/port.
# Example: CORS_ORIGIN=https://egyptadvisortours.com
# Leave blank to use the server default: https://egyptadvisortours.com in production;
# development uses open CORS.
CORS_ORIGIN=

# ============================================================
# PAYLOAD CMS — runtime variables for the cms/ Next.js service
# ============================================================

# Secret key used by Payload to sign its own auth tokens.
# Generate one: https://generate-secret.now.sh/32
PAYLOAD_SECRET=replace-with-a-long-random-secret-for-payload

# Where the SQLite database file is stored.
# Should be an absolute path outside the project root (same persistent
# directory as DATA_PATH above) so it survives re-deployments.
#
# Example for Hostinger:
#   DATABASE_PATH=/home/u123456789/admin_data/payload.db
#
# Leave blank to use the default: <project>/data/payload.db
DATABASE_PATH=

# Internal URL that the Express server uses to reach the CMS service.
# On the same machine (Hostinger / Docker host) this is typically:
#   CMS_URL=http://localhost:3001
# In Docker Compose it is the service name:
#   CMS_URL=http://cms:3001
CMS_URL=http://localhost:3001

# Port the Payload CMS Next.js app listens on (defaults to 3001 if not set).
# Change this if 3001 is already in use on your server.
CMS_PORT=3001

# Public URL of the server — used by Payload to generate absolute URLs.
# Set to your domain in production:
#   PAYLOAD_SERVER_URL=https://egyptadvisortours.com
PAYLOAD_SERVER_URL=

# ============================================================
# CLIENT — build-time variables (set BEFORE running npm run build)
# All React env vars MUST start with REACT_APP_
# On Hostinger fill them in client/.env before building.
# ============================================================

# Backend API base URL.
# Leave empty to use relative paths — correct for same-origin Hostinger.
REACT_APP_API_URL=

# ---------------------------------------------------------------
# EmailJS credentials — required for booking & trip-tailor email forms.
# Sign up for free at https://www.emailjs.com (200 emails/month free).
#
# HOW TO FIND EACH VALUE:
#   REACT_APP_EMAILJS_SERVICE_ID
#       → EmailJS dashboard → "Email Services" tab
#       → click your connected service → copy the Service ID (e.g. service_abc123)
#
#   REACT_APP_EMAILJS_BOOKING_TEMPLATE_ID
#       → EmailJS dashboard → "Email Templates" tab
#       → open your booking confirmation template → copy Template ID (e.g. template_xyz789)
#
#   REACT_APP_EMAILJS_TRIPTAILOR_TEMPLATE_ID
#       → EmailJS dashboard → "Email Templates" tab
#       → open your "Tailor My Trip" template → copy Template ID
#
#   REACT_APP_EMAILJS_PUBLIC_KEY
#       → EmailJS dashboard → top-right avatar → Account → API Keys
#       → copy the Public Key (starts with a random string, e.g. ABCDE12345)
# ---------------------------------------------------------------
REACT_APP_EMAILJS_SERVICE_ID=your_emailjs_service_id
REACT_APP_EMAILJS_BOOKING_TEMPLATE_ID=your_booking_template_id
REACT_APP_EMAILJS_TRIPTAILOR_TEMPLATE_ID=your_triptailor_template_id
REACT_APP_EMAILJS_PUBLIC_KEY=your_emailjs_public_key
