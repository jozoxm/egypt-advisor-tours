# ============================================================
# Egypt Advisor Tours — Environment Variables Reference
# ============================================================
# The Express server reads this file at startup. WordPress (headless) is used
# as the primary CMS for editor-managed content, with a filesystem fallback.
# Bookings remain stored on the server.

# ============================================================
# SERVER
# ============================================================
PORT=5000

ADMIN_SECRET=replace-with-a-long-random-secret
ADMIN_PASSWORD=replace-with-a-secure-password
ADMIN_USERNAME=admin

# Optional writable directory outside the repo for bookings / JSON fallbacks.
DATA_PATH=

CORS_ORIGIN=

# ============================================================
# WORDPRESS (headless CMS — primary)
# ============================================================
# URL of the WordPress installation used as a headless CMS.
# Default: https://cms.egyptadvisortours.com
WORDPRESS_BASE_URL=https://cms.egyptadvisortours.com

# Request timeout in milliseconds for WordPress REST API calls.
# Default: 8000
WORDPRESS_TIMEOUT_MS=8000

# In-memory cache TTL in milliseconds for WordPress REST API responses.
# Default: 300000 (5 minutes)
WORDPRESS_CACHE_TTL_MS=300000

# ============================================================
# CMS PROVIDER
# ============================================================
# Explicitly select the CMS provider: wordpress | storyblok | filesystem
# If omitted, the provider is auto-detected from configured env vars.
CMS_PROVIDER=wordpress

# ============================================================
# STORYBLOK (legacy — kept for reference)
# ============================================================
# These vars are no longer required. Storyblok is used only if
# CMS_PROVIDER=storyblok or STORYBLOK_PREVIEW_TOKEN is set and
# WORDPRESS_BASE_URL is not set.
#
# STORYBLOK_PREVIEW_TOKEN=replace-with-your-storyblok-preview-token
# STORYBLOK_REGION=eu
# STORYBLOK_SPACE_ID=
# STORYBLOK_EDITOR_URL=
# STORYBLOK_MANAGEMENT_TOKEN=
# STORYBLOK_PREVIEW_SECRET=
# STORYBLOK_TOURS_SLUG=cms-tours
# STORYBLOK_CONTACT_SLUG=cms-contact
# STORYBLOK_BLOGS_SLUG=cms-blogs
# STORYBLOK_GALLERY_SLUG=cms-gallery
# STORYBLOK_SLIDESHOW_SLUG=cms-slideshow
# STORYBLOK_SETTINGS_SLUG=cms-settings
# STORYBLOK_PROMOTIONS_SLUG=cms-promotions
# STORYBLOK_DESTINATIONS_SLUG=cms-destinations
# STORYBLOK_CONTENT_COMPONENT=json_document

# ============================================================
# CLIENT — build-time variables
# ============================================================
REACT_APP_API_URL=
REACT_APP_EMAILJS_SERVICE_ID=your_emailjs_service_id
REACT_APP_EMAILJS_BOOKING_TEMPLATE_ID=your_booking_template_id
REACT_APP_EMAILJS_TRIPTAILOR_TEMPLATE_ID=your_triptailor_template_id
REACT_APP_EMAILJS_PUBLIC_KEY=your_emailjs_public_key
