# ============================================================
# Egypt Advisor Tours — Environment Variables Reference
# ============================================================
# The Express server reads this file at startup. Choose CMS_PROVIDER to control
# where editor-managed website content is sourced from (WordPress/Storyblok/filesystem).

# ============================================================
# SERVER
# ============================================================
PORT=5000
CMS_PROVIDER=auto

ADMIN_SECRET=replace-with-a-long-random-secret
ADMIN_PASSWORD=replace-with-a-secure-password
ADMIN_USERNAME=admin

# Optional writable directory outside the repo for bookings / JSON fallbacks.
DATA_PATH=

CORS_ORIGIN=
PUBLIC_SITE_URL=https://egyptadvisortours.com

# Optional prerender support for SEO crawlers (Prerender.io or compatible service).
# When PRERENDER_TOKEN is set, crawler user-agents receive prerendered HTML snapshots.
PRERENDER_TOKEN=
PRERENDER_SERVICE_URL=https://service.prerender.io
PRERENDER_TIMEOUT_MS=3000

# ============================================================
# WORDPRESS (headless CMS)
# ============================================================
# Use CMS_PROVIDER=wordpress to fetch editor-managed content from WordPress.
# Defaults to https://cms.egyptadvisortours.com when CMS_PROVIDER=wordpress.
WORDPRESS_BASE_URL=
# Legacy aliases also supported: WORDPRESS_URL or CMS_URL.

# Optional namespace for custom content endpoints:
# <WORDPRESS_BASE_URL>/wp-json/<WORDPRESS_API_NAMESPACE>/<resource>
WORDPRESS_API_NAMESPACE=ramacf/v1

# Optional per-resource slug overrides for wp/v2 fallback lookups.
WORDPRESS_TOURS_SLUG=cms-tours
WORDPRESS_CONTACT_SLUG=cms-contact
WORDPRESS_BLOGS_SLUG=cms-blogs
WORDPRESS_GALLERY_SLUG=cms-gallery
WORDPRESS_SLIDESHOW_SLUG=cms-slideshow
WORDPRESS_SETTINGS_SLUG=cms-settings
WORDPRESS_PROMOTIONS_SLUG=cms-promotions
WORDPRESS_DESTINATIONS_SLUG=cms-destinations
WORDPRESS_NAVIGATION_SLUG=cms-navigation
WORDPRESS_FAQ_SLUG=cms-faq
WORDPRESS_TAILOR_TRIP_SLUG=cms-tailor-trip
WORDPRESS_HOMEPAGE_SLUG=cms-homepage
WORDPRESS_ABOUT_SLUG=cms-about
WORDPRESS_FOOTER_SLUG=cms-footer

# Optional timeout tuning (milliseconds)
WORDPRESS_TIMEOUT_MS=5000
WORDPRESS_HEALTH_TIMEOUT_MS=3000

# ============================================================
# STORYBLOK
# ============================================================
# Required in production. Use a Preview token so the site can read draft and
# published content through the same integration.
STORYBLOK_PREVIEW_TOKEN=replace-with-your-storyblok-preview-token

# Optional when using the US region. Defaults to "eu".
STORYBLOK_REGION=eu

# Required for the /admin redirect and the sync script.
STORYBLOK_SPACE_ID=

# Optional direct editor URL override. If omitted, /admin uses STORYBLOK_SPACE_ID.
STORYBLOK_EDITOR_URL=

# Optional if you want the legacy admin write endpoints or the sync script to
# update Storyblok content via the Management API.
STORYBLOK_MANAGEMENT_TOKEN=

# Optional secret for Storyblok preview URLs:
# /api/admin/preview/<value>
STORYBLOK_PREVIEW_SECRET=

# Optional overrides if your stories use different slugs.
STORYBLOK_TOURS_SLUG=cms-tours
STORYBLOK_CONTACT_SLUG=cms-contact
STORYBLOK_BLOGS_SLUG=cms-blogs
STORYBLOK_GALLERY_SLUG=cms-gallery
STORYBLOK_SLIDESHOW_SLUG=cms-slideshow
STORYBLOK_SETTINGS_SLUG=cms-settings
STORYBLOK_PROMOTIONS_SLUG=cms-promotions
STORYBLOK_DESTINATIONS_SLUG=cms-destinations

# Optional component name used by npm run sync:storyblok
STORYBLOK_CONTENT_COMPONENT=json_document

# ============================================================
# CLIENT — build-time variables
# ============================================================
REACT_APP_API_URL=
REACT_APP_SITE_URL=https://egyptadvisortours.com
REACT_APP_EMAILJS_SERVICE_ID=your_emailjs_service_id
REACT_APP_EMAILJS_BOOKING_TEMPLATE_ID=your_booking_template_id
REACT_APP_EMAILJS_TRIPTAILOR_TEMPLATE_ID=your_triptailor_template_id
REACT_APP_EMAILJS_PUBLIC_KEY=your_emailjs_public_key
